# GO USER / SafarGo Platform Environment Configuration
# Built-in zero-breakage dual engine: operates locally with resilient offline storage
# or with live Supabase PostgreSQL and Row Level Security.

# 1. Supabase PostgreSQL & Auth Dual-Engine Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Firebase Database, Auth & Storage Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=safargo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=safargo
VITE_FIREBASE_STORAGE_BUCKET=safargo.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# 3. GO USER Brand & Business Rules
VITE_APP_NAME=GO USER
VITE_APP_TAGLINE=अब हर सफर होगा आसान • सुरक्षित बस बुकिंग टर्मिनल
VITE_DEFAULT_SUPPORT_WHATSAPP=919876543210
# Business Rules:
# Flat ₹20 commission per valid booking approved by admin
VITE_DEFAULT_COMMISSION=20
# Monthly target for fixed salary eligibility
VITE_DEFAULT_TARGET=280
# Fixed monthly salary (earned only upon reaching 280 tickets; not prorated below target)
VITE_DEFAULT_SALARY=10000
