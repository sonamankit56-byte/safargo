# SafarGo Environment Configuration
# The application automatically runs with a built-in safe storage engine when cloud variables are empty,
# ensuring full zero-breakage development, testing, and immediate presentation.

# 1. Supabase Dual-Engine Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Firebase Database, Auth & Storage Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=safargo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=safargo
VITE_FIREBASE_STORAGE_BUCKET=safargo.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# 3. SafarGo Brand Settings
VITE_APP_NAME=SafarGo
VITE_APP_TAGLINE=अब हर सफर होगा आसान
VITE_DEFAULT_SUPPORT_WHATSAPP=919876543210
VITE_DEFAULT_COMMISSION=19.34
VITE_DEFAULT_TARGET=150
VITE_DEFAULT_SALARY=5000
