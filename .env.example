# SafarGo Environment Configuration
# Copy this file to .env.local or .env and provide your actual Supabase project credentials.
# The application automatically runs with a built-in mock/demo storage engine if Supabase variables are empty,
# ensuring full zero-breakage development, testing, and immediate presentation.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# SafarGo Brand Settings
VITE_APP_NAME=SafarGo
VITE_APP_TAGLINE=अब हर सफर होगा आसान
VITE_DEFAULT_SUPPORT_WHATSAPP=919876543210
VITE_DEFAULT_COMMISSION=19.34
VITE_DEFAULT_TARGET=150
VITE_DEFAULT_SALARY=5000
